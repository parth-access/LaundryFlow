# Copy this file to .env.local and fill it in. .env.local is git-ignored: never commit real passwords.

# Local PostgreSQL:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/laundryflow

# Supabase (use the "Transaction pooler" string from Project Settings > Database):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
